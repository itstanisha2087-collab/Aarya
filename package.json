{
  "name": "aarya-ui",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "electron-dev": "concurrently -k \"next dev -p 3000\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron-min": "concurrently -k \"next dev -p 3000\" \"wait-on http://127.0.0.1:3000 && electron . --minimized\""
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "realm-web": "^2.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "wait-on": "^9.0.10"
  }
}
